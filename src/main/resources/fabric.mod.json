{
  "schemaVersion": 1,
  "id": "tlz-autofish",
  "version": "${version}",
  "name": "TLZ AutoFish",
  "description": "AutoFish addon with Stardew-style fishing minigame support for IkuyoMC.",
  "authors": [
    "tlz"
  ],
  "contact": {
    "sources": "https://github.com/TuiLaZeroTwo/autofish-ikuyomc.net"
  },
  "icon": "assets/template/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "tlz.autofish.addon.Autofish"
    ]
  },
  "mixins": [
    "tlz-autofish.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
